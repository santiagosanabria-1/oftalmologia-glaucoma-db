digraph G {
  graph [rankdir=LR, splines=spline, nodesep=0.35, ranksep=1.6, pad=0.4, bgcolor="white", fontname="Helvetica"];
  node [fontname="Helvetica", fontsize=11];
  edge [fontname="Helvetica", fontsize=9, color="#7A869A", penwidth=1.3];
  document_types [shape=plain, label=<<TABLE BORDER="1" COLOR="#4A6FA5" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#EEF3FA"><TR><TD COLSPAN="3" BGCOLOR="#4A6FA5" ALIGN="CENTER" CELLPADDING="7"><FONT COLOR="white" POINT-SIZE="13"><B>document_types</B></FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="34" PORT="id_w"><FONT POINT-SIZE="9" COLOR="#B7791F"><B>PK</B></FONT></TD><TD ALIGN="LEFT"><B>id</B></TD><TD ALIGN="LEFT" PORT="id_e"><FONT COLOR="#6B7280" POINT-SIZE="10">tinyint(4)</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="34" PORT="code_w"><FONT POINT-SIZE="9" COLOR="#4A6FA5"><B>UQ</B></FONT></TD><TD ALIGN="LEFT">code</TD><TD ALIGN="LEFT" PORT="code_e"><FONT COLOR="#6B7280" POINT-SIZE="10">varchar(5)</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="34" PORT="name_w"> </TD><TD ALIGN="LEFT">name</TD><TD ALIGN="LEFT" PORT="name_e"><FONT COLOR="#6B7280" POINT-SIZE="10">varchar(50)</FONT></TD></TR></TABLE>>];
  cities [shape=plain, label=<<TABLE BORDER="1" COLOR="#4A6FA5" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#EEF3FA"><TR><TD COLSPAN="3" BGCOLOR="#4A6FA5" ALIGN="CENTER" CELLPADDING="7"><FONT COLOR="white" POINT-SIZE="13"><B>cities</B></FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="34" PORT="id_w"><FONT POINT-SIZE="9" COLOR="#B7791F"><B>PK</B></FONT></TD><TD ALIGN="LEFT"><B>id</B></TD><TD ALIGN="LEFT" PORT="id_e"><FONT COLOR="#6B7280" POINT-SIZE="10">int(11)</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="34" PORT="name_w"><FONT POINT-SIZE="9" COLOR="#4A6FA5"><B>UQ</B></FONT></TD><TD ALIGN="LEFT">name</TD><TD ALIGN="LEFT" PORT="name_e"><FONT COLOR="#6B7280" POINT-SIZE="10">varchar(100)</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="34" PORT="department_w"><FONT POINT-SIZE="9" COLOR="#4A6FA5"><B>UQ</B></FONT></TD><TD ALIGN="LEFT">department</TD><TD ALIGN="LEFT" PORT="department_e"><FONT COLOR="#6B7280" POINT-SIZE="10">varchar(100)</FONT></TD></TR></TABLE>>];
  specialties [shape=plain, label=<<TABLE BORDER="1" COLOR="#4A6FA5" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#EEF3FA"><TR><TD COLSPAN="3" BGCOLOR="#4A6FA5" ALIGN="CENTER" CELLPADDING="7"><FONT COLOR="white" POINT-SIZE="13"><B>specialties</B></FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="34" PORT="id_w"><FONT POINT-SIZE="9" COLOR="#B7791F"><B>PK</B></FONT></TD><TD ALIGN="LEFT"><B>id</B></TD><TD ALIGN="LEFT" PORT="id_e"><FONT COLOR="#6B7280" POINT-SIZE="10">int(11)</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="34" PORT="name_w"><FONT POINT-SIZE="9" COLOR="#4A6FA5"><B>UQ</B></FONT></TD><TD ALIGN="LEFT">name</TD><TD ALIGN="LEFT" PORT="name_e"><FONT COLOR="#6B7280" POINT-SIZE="10">varchar(100)</FONT></TD></TR></TABLE>>];
  allergens [shape=plain, label=<<TABLE BORDER="1" COLOR="#4A6FA5" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#EEF3FA"><TR><TD COLSPAN="3" BGCOLOR="#4A6FA5" ALIGN="CENTER" CELLPADDING="7"><FONT COLOR="white" POINT-SIZE="13"><B>allergens</B></FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="34" PORT="id_w"><FONT POINT-SIZE="9" COLOR="#B7791F"><B>PK</B></FONT></TD><TD ALIGN="LEFT"><B>id</B></TD><TD ALIGN="LEFT" PORT="id_e"><FONT COLOR="#6B7280" POINT-SIZE="10">int(11)</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="34" PORT="name_w"><FONT POINT-SIZE="9" COLOR="#4A6FA5"><B>UQ</B></FONT></TD><TD ALIGN="LEFT">name</TD><TD ALIGN="LEFT" PORT="name_e"><FONT COLOR="#6B7280" POINT-SIZE="10">varchar(100)</FONT></TD></TR></TABLE>>];
  history_types [shape=plain, label=<<TABLE BORDER="1" COLOR="#4A6FA5" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#EEF3FA"><TR><TD COLSPAN="3" BGCOLOR="#4A6FA5" ALIGN="CENTER" CELLPADDING="7"><FONT COLOR="white" POINT-SIZE="13"><B>history_types</B></FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="34" PORT="id_w"><FONT POINT-SIZE="9" COLOR="#B7791F"><B>PK</B></FONT></TD><TD ALIGN="LEFT"><B>id</B></TD><TD ALIGN="LEFT" PORT="id_e"><FONT COLOR="#6B7280" POINT-SIZE="10">int(11)</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="34" PORT="name_w"><FONT POINT-SIZE="9" COLOR="#4A6FA5"><B>UQ</B></FONT></TD><TD ALIGN="LEFT">name</TD><TD ALIGN="LEFT" PORT="name_e"><FONT COLOR="#6B7280" POINT-SIZE="10">varchar(50)</FONT></TD></TR></TABLE>>];
  diagnoses [shape=plain, label=<<TABLE BORDER="1" COLOR="#4A6FA5" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#EEF3FA"><TR><TD COLSPAN="3" BGCOLOR="#4A6FA5" ALIGN="CENTER" CELLPADDING="7"><FONT COLOR="white" POINT-SIZE="13"><B>diagnoses</B></FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="34" PORT="id_w"><FONT POINT-SIZE="9" COLOR="#B7791F"><B>PK</B></FONT></TD><TD ALIGN="LEFT"><B>id</B></TD><TD ALIGN="LEFT" PORT="id_e"><FONT COLOR="#6B7280" POINT-SIZE="10">int(11)</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="34" PORT="code_w"><FONT POINT-SIZE="9" COLOR="#4A6FA5"><B>UQ</B></FONT></TD><TD ALIGN="LEFT">code</TD><TD ALIGN="LEFT" PORT="code_e"><FONT COLOR="#6B7280" POINT-SIZE="10">varchar(10)</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="34" PORT="name_w"> </TD><TD ALIGN="LEFT">name</TD><TD ALIGN="LEFT" PORT="name_e"><FONT COLOR="#6B7280" POINT-SIZE="10">varchar(150)</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="34" PORT="is_glaucoma_w"> </TD><TD ALIGN="LEFT">is_glaucoma</TD><TD ALIGN="LEFT" PORT="is_glaucoma_e"><FONT COLOR="#6B7280" POINT-SIZE="10">tinyint(1)</FONT></TD></TR></TABLE>>];
  glaucoma_types [shape=plain, label=<<TABLE BORDER="1" COLOR="#4A6FA5" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#EEF3FA"><TR><TD COLSPAN="3" BGCOLOR="#4A6FA5" ALIGN="CENTER" CELLPADDING="7"><FONT COLOR="white" POINT-SIZE="13"><B>glaucoma_types</B></FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="34" PORT="id_w"><FONT POINT-SIZE="9" COLOR="#B7791F"><B>PK</B></FONT></TD><TD ALIGN="LEFT"><B>id</B></TD><TD ALIGN="LEFT" PORT="id_e"><FONT COLOR="#6B7280" POINT-SIZE="10">int(11)</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="34" PORT="name_w"><FONT POINT-SIZE="9" COLOR="#4A6FA5"><B>UQ</B></FONT></TD><TD ALIGN="LEFT">name</TD><TD ALIGN="LEFT" PORT="name_e"><FONT COLOR="#6B7280" POINT-SIZE="10">varchar(100)</FONT></TD></TR></TABLE>>];
  medications [shape=plain, label=<<TABLE BORDER="1" COLOR="#4A6FA5" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#EEF3FA"><TR><TD COLSPAN="3" BGCOLOR="#4A6FA5" ALIGN="CENTER" CELLPADDING="7"><FONT COLOR="white" POINT-SIZE="13"><B>medications</B></FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="34" PORT="id_w"><FONT POINT-SIZE="9" COLOR="#B7791F"><B>PK</B></FONT></TD><TD ALIGN="LEFT"><B>id</B></TD><TD ALIGN="LEFT" PORT="id_e"><FONT COLOR="#6B7280" POINT-SIZE="10">int(11)</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="34" PORT="name_w"><FONT POINT-SIZE="9" COLOR="#4A6FA5"><B>UQ</B></FONT></TD><TD ALIGN="LEFT">name</TD><TD ALIGN="LEFT" PORT="name_e"><FONT COLOR="#6B7280" POINT-SIZE="10">varchar(100)</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="34" PORT="active_ingredient_w"> </TD><TD ALIGN="LEFT">active_ingredient</TD><TD ALIGN="LEFT" PORT="active_ingredient_e"><FONT COLOR="#6B7280" POINT-SIZE="10">varchar(100)</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="34" PORT="presentation_w"> </TD><TD ALIGN="LEFT">presentation</TD><TD ALIGN="LEFT" PORT="presentation_e"><FONT COLOR="#6B7280" POINT-SIZE="10">varchar(100)</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="34" PORT="is_active_w"> </TD><TD ALIGN="LEFT">is_active</TD><TD ALIGN="LEFT" PORT="is_active_e"><FONT COLOR="#6B7280" POINT-SIZE="10">tinyint(1)</FONT></TD></TR></TABLE>>];
  procedure_types [shape=plain, label=<<TABLE BORDER="1" COLOR="#4A6FA5" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#EEF3FA"><TR><TD COLSPAN="3" BGCOLOR="#4A6FA5" ALIGN="CENTER" CELLPADDING="7"><FONT COLOR="white" POINT-SIZE="13"><B>procedure_types</B></FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="34" PORT="id_w"><FONT POINT-SIZE="9" COLOR="#B7791F"><B>PK</B></FONT></TD><TD ALIGN="LEFT"><B>id</B></TD><TD ALIGN="LEFT" PORT="id_e"><FONT COLOR="#6B7280" POINT-SIZE="10">int(11)</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="34" PORT="name_w"><FONT POINT-SIZE="9" COLOR="#4A6FA5"><B>UQ</B></FONT></TD><TD ALIGN="LEFT">name</TD><TD ALIGN="LEFT" PORT="name_e"><FONT COLOR="#6B7280" POINT-SIZE="10">varchar(100)</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="34" PORT="category_w"> </TD><TD ALIGN="LEFT">category</TD><TD ALIGN="LEFT" PORT="category_e"><FONT COLOR="#6B7280" POINT-SIZE="10">enum('QUIRURGICO','LASER',…)</FONT></TD></TR></TABLE>>];
  patients [shape=plain, label=<<TABLE BORDER="1" COLOR="#0F7C7C" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#E8F6F5"><TR><TD COLSPAN="3" BGCOLOR="#0F7C7C" ALIGN="CENTER" CELLPADDING="7"><FONT COLOR="white" POINT-SIZE="13"><B>patients</B></FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="34" PORT="id_w"><FONT POINT-SIZE="9" COLOR="#B7791F"><B>PK</B></FONT></TD><TD ALIGN="LEFT"><B>id</B></TD><TD ALIGN="LEFT" PORT="id_e"><FONT COLOR="#6B7280" POINT-SIZE="10">bigint(20)</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="34" PORT="document_type_id_w"><FONT POINT-SIZE="9" COLOR="#0F7C7C"><B>FK</B></FONT></TD><TD ALIGN="LEFT">document_type_id</TD><TD ALIGN="LEFT" PORT="document_type_id_e"><FONT COLOR="#6B7280" POINT-SIZE="10">tinyint(4)</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="34" PORT="document_number_w"><FONT POINT-SIZE="9" COLOR="#0F7C7C"><B>UQ</B></FONT></TD><TD ALIGN="LEFT">document_number</TD><TD ALIGN="LEFT" PORT="document_number_e"><FONT COLOR="#6B7280" POINT-SIZE="10">varchar(20)</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="34" PORT="first_name_w"> </TD><TD ALIGN="LEFT">first_name</TD><TD ALIGN="LEFT" PORT="first_name_e"><FONT COLOR="#6B7280" POINT-SIZE="10">varchar(100)</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="34" PORT="last_name_w"> </TD><TD ALIGN="LEFT">last_name</TD><TD ALIGN="LEFT" PORT="last_name_e"><FONT COLOR="#6B7280" POINT-SIZE="10">varchar(100)</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="34" PORT="birth_date_w"> </TD><TD ALIGN="LEFT">birth_date</TD><TD ALIGN="LEFT" PORT="birth_date_e"><FONT COLOR="#6B7280" POINT-SIZE="10">date</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="34" PORT="sex_w"> </TD><TD ALIGN="LEFT">sex</TD><TD ALIGN="LEFT" PORT="sex_e"><FONT COLOR="#6B7280" POINT-SIZE="10">enum('M','F')</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="34" PORT="email_w"> </TD><TD ALIGN="LEFT">email</TD><TD ALIGN="LEFT" PORT="email_e"><FONT COLOR="#6B7280" POINT-SIZE="10">varchar(150)</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="34" PORT="phone_w"> </TD><TD ALIGN="LEFT">phone</TD><TD ALIGN="LEFT" PORT="phone_e"><FONT COLOR="#6B7280" POINT-SIZE="10">varchar(20)</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="34" PORT="address_w"> </TD><TD ALIGN="LEFT">address</TD><TD ALIGN="LEFT" PORT="address_e"><FONT COLOR="#6B7280" POINT-SIZE="10">varchar(200)</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="34" PORT="city_id_w"><FONT POINT-SIZE="9" COLOR="#0F7C7C"><B>FK</B></FONT></TD><TD ALIGN="LEFT">city_id</TD><TD ALIGN="LEFT" PORT="city_id_e"><FONT COLOR="#6B7280" POINT-SIZE="10">int(11)</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="34" PORT="created_at_w"> </TD><TD ALIGN="LEFT">created_at</TD><TD ALIGN="LEFT" PORT="created_at_e"><FONT COLOR="#6B7280" POINT-SIZE="10">datetime</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="34" PORT="updated_at_w"> </TD><TD ALIGN="LEFT">updated_at</TD><TD ALIGN="LEFT" PORT="updated_at_e"><FONT COLOR="#6B7280" POINT-SIZE="10">datetime</FONT></TD></TR></TABLE>>];
  clinical_histories [shape=plain, label=<<TABLE BORDER="1" COLOR="#0F7C7C" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#E8F6F5"><TR><TD COLSPAN="3" BGCOLOR="#0F7C7C" ALIGN="CENTER" CELLPADDING="7"><FONT COLOR="white" POINT-SIZE="13"><B>clinical_histories</B></FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="34" PORT="id_w"><FONT POINT-SIZE="9" COLOR="#B7791F"><B>PK</B></FONT></TD><TD ALIGN="LEFT"><B>id</B></TD><TD ALIGN="LEFT" PORT="id_e"><FONT COLOR="#6B7280" POINT-SIZE="10">bigint(20)</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="34" PORT="patient_id_w"><FONT POINT-SIZE="9" COLOR="#0F7C7C"><B>FK UQ</B></FONT></TD><TD ALIGN="LEFT">patient_id</TD><TD ALIGN="LEFT" PORT="patient_id_e"><FONT COLOR="#6B7280" POINT-SIZE="10">bigint(20)</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="34" PORT="history_number_w"><FONT POINT-SIZE="9" COLOR="#0F7C7C"><B>UQ</B></FONT></TD><TD ALIGN="LEFT">history_number</TD><TD ALIGN="LEFT" PORT="history_number_e"><FONT COLOR="#6B7280" POINT-SIZE="10">varchar(20)</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="34" PORT="opened_at_w"> </TD><TD ALIGN="LEFT">opened_at</TD><TD ALIGN="LEFT" PORT="opened_at_e"><FONT COLOR="#6B7280" POINT-SIZE="10">datetime</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="34" PORT="status_w"> </TD><TD ALIGN="LEFT">status</TD><TD ALIGN="LEFT" PORT="status_e"><FONT COLOR="#6B7280" POINT-SIZE="10">enum('ACTIVA','CERRADA')</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="34" PORT="updated_at_w"> </TD><TD ALIGN="LEFT">updated_at</TD><TD ALIGN="LEFT" PORT="updated_at_e"><FONT COLOR="#6B7280" POINT-SIZE="10">datetime</FONT></TD></TR></TABLE>>];
  patient_allergies [shape=plain, label=<<TABLE BORDER="1" COLOR="#0F7C7C" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#E8F6F5"><TR><TD COLSPAN="3" BGCOLOR="#0F7C7C" ALIGN="CENTER" CELLPADDING="7"><FONT COLOR="white" POINT-SIZE="13"><B>patient_allergies</B></FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="34" PORT="patient_id_w"><FONT POINT-SIZE="9" COLOR="#B7791F"><B>PK FK</B></FONT></TD><TD ALIGN="LEFT"><B>patient_id</B></TD><TD ALIGN="LEFT" PORT="patient_id_e"><FONT COLOR="#6B7280" POINT-SIZE="10">bigint(20)</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="34" PORT="allergen_id_w"><FONT POINT-SIZE="9" COLOR="#B7791F"><B>PK FK</B></FONT></TD><TD ALIGN="LEFT"><B>allergen_id</B></TD><TD ALIGN="LEFT" PORT="allergen_id_e"><FONT COLOR="#6B7280" POINT-SIZE="10">int(11)</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="34" PORT="reaction_w"> </TD><TD ALIGN="LEFT">reaction</TD><TD ALIGN="LEFT" PORT="reaction_e"><FONT COLOR="#6B7280" POINT-SIZE="10">varchar(200)</FONT></TD></TR></TABLE>>];
  patient_family_histories [shape=plain, label=<<TABLE BORDER="1" COLOR="#0F7C7C" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#E8F6F5"><TR><TD COLSPAN="3" BGCOLOR="#0F7C7C" ALIGN="CENTER" CELLPADDING="7"><FONT COLOR="white" POINT-SIZE="13"><B>patient_family_histories</B></FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="34" PORT="id_w"><FONT POINT-SIZE="9" COLOR="#B7791F"><B>PK</B></FONT></TD><TD ALIGN="LEFT"><B>id</B></TD><TD ALIGN="LEFT" PORT="id_e"><FONT COLOR="#6B7280" POINT-SIZE="10">bigint(20)</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="34" PORT="patient_id_w"><FONT POINT-SIZE="9" COLOR="#0F7C7C"><B>FK UQ</B></FONT></TD><TD ALIGN="LEFT">patient_id</TD><TD ALIGN="LEFT" PORT="patient_id_e"><FONT COLOR="#6B7280" POINT-SIZE="10">bigint(20)</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="34" PORT="diagnosis_id_w"><FONT POINT-SIZE="9" COLOR="#0F7C7C"><B>FK UQ</B></FONT></TD><TD ALIGN="LEFT">diagnosis_id</TD><TD ALIGN="LEFT" PORT="diagnosis_id_e"><FONT COLOR="#6B7280" POINT-SIZE="10">int(11)</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="34" PORT="relationship_w"><FONT POINT-SIZE="9" COLOR="#0F7C7C"><B>UQ</B></FONT></TD><TD ALIGN="LEFT">relationship</TD><TD ALIGN="LEFT" PORT="relationship_e"><FONT COLOR="#6B7280" POINT-SIZE="10">enum('PADRE','MADRE','HERM…)</FONT></TD></TR></TABLE>>];
  patient_personal_histories [shape=plain, label=<<TABLE BORDER="1" COLOR="#0F7C7C" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#E8F6F5"><TR><TD COLSPAN="3" BGCOLOR="#0F7C7C" ALIGN="CENTER" CELLPADDING="7"><FONT COLOR="white" POINT-SIZE="13"><B>patient_personal_histories</B></FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="34" PORT="id_w"><FONT POINT-SIZE="9" COLOR="#B7791F"><B>PK</B></FONT></TD><TD ALIGN="LEFT"><B>id</B></TD><TD ALIGN="LEFT" PORT="id_e"><FONT COLOR="#6B7280" POINT-SIZE="10">bigint(20)</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="34" PORT="patient_id_w"><FONT POINT-SIZE="9" COLOR="#0F7C7C"><B>FK</B></FONT></TD><TD ALIGN="LEFT">patient_id</TD><TD ALIGN="LEFT" PORT="patient_id_e"><FONT COLOR="#6B7280" POINT-SIZE="10">bigint(20)</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="34" PORT="history_type_id_w"><FONT POINT-SIZE="9" COLOR="#0F7C7C"><B>FK</B></FONT></TD><TD ALIGN="LEFT">history_type_id</TD><TD ALIGN="LEFT" PORT="history_type_id_e"><FONT COLOR="#6B7280" POINT-SIZE="10">int(11)</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="34" PORT="description_w"> </TD><TD ALIGN="LEFT">description</TD><TD ALIGN="LEFT" PORT="description_e"><FONT COLOR="#6B7280" POINT-SIZE="10">varchar(255)</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="34" PORT="recorded_at_w"> </TD><TD ALIGN="LEFT">recorded_at</TD><TD ALIGN="LEFT" PORT="recorded_at_e"><FONT COLOR="#6B7280" POINT-SIZE="10">date</FONT></TD></TR></TABLE>>];
  healthcare_professionals [shape=plain, label=<<TABLE BORDER="1" COLOR="#5B4BB7" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#F0EEFB"><TR><TD COLSPAN="3" BGCOLOR="#5B4BB7" ALIGN="CENTER" CELLPADDING="7"><FONT COLOR="white" POINT-SIZE="13"><B>healthcare_professionals</B></FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="34" PORT="id_w"><FONT POINT-SIZE="9" COLOR="#B7791F"><B>PK</B></FONT></TD><TD ALIGN="LEFT"><B>id</B></TD><TD ALIGN="LEFT" PORT="id_e"><FONT COLOR="#6B7280" POINT-SIZE="10">bigint(20)</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="34" PORT="document_number_w"><FONT POINT-SIZE="9" COLOR="#5B4BB7"><B>UQ</B></FONT></TD><TD ALIGN="LEFT">document_number</TD><TD ALIGN="LEFT" PORT="document_number_e"><FONT COLOR="#6B7280" POINT-SIZE="10">varchar(20)</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="34" PORT="first_name_w"> </TD><TD ALIGN="LEFT">first_name</TD><TD ALIGN="LEFT" PORT="first_name_e"><FONT COLOR="#6B7280" POINT-SIZE="10">varchar(100)</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="34" PORT="last_name_w"> </TD><TD ALIGN="LEFT">last_name</TD><TD ALIGN="LEFT" PORT="last_name_e"><FONT COLOR="#6B7280" POINT-SIZE="10">varchar(100)</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="34" PORT="specialty_id_w"><FONT POINT-SIZE="9" COLOR="#5B4BB7"><B>FK</B></FONT></TD><TD ALIGN="LEFT">specialty_id</TD><TD ALIGN="LEFT" PORT="specialty_id_e"><FONT COLOR="#6B7280" POINT-SIZE="10">int(11)</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="34" PORT="license_number_w"><FONT POINT-SIZE="9" COLOR="#5B4BB7"><B>UQ</B></FONT></TD><TD ALIGN="LEFT">license_number</TD><TD ALIGN="LEFT" PORT="license_number_e"><FONT COLOR="#6B7280" POINT-SIZE="10">varchar(30)</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="34" PORT="email_w"> </TD><TD ALIGN="LEFT">email</TD><TD ALIGN="LEFT" PORT="email_e"><FONT COLOR="#6B7280" POINT-SIZE="10">varchar(150)</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="34" PORT="phone_w"> </TD><TD ALIGN="LEFT">phone</TD><TD ALIGN="LEFT" PORT="phone_e"><FONT COLOR="#6B7280" POINT-SIZE="10">varchar(20)</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="34" PORT="is_active_w"> </TD><TD ALIGN="LEFT">is_active</TD><TD ALIGN="LEFT" PORT="is_active_e"><FONT COLOR="#6B7280" POINT-SIZE="10">tinyint(1)</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="34" PORT="created_at_w"> </TD><TD ALIGN="LEFT">created_at</TD><TD ALIGN="LEFT" PORT="created_at_e"><FONT COLOR="#6B7280" POINT-SIZE="10">datetime</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="34" PORT="updated_at_w"> </TD><TD ALIGN="LEFT">updated_at</TD><TD ALIGN="LEFT" PORT="updated_at_e"><FONT COLOR="#6B7280" POINT-SIZE="10">datetime</FONT></TD></TR></TABLE>>];
