digraph G {
  graph [rankdir=LR, splines=spline, nodesep=0.35, ranksep=1.6, pad=0.4, bgcolor="white", fontname="Helvetica"];
  node [fontname="Helvetica", fontsize=11];
  edge [fontname="Helvetica", fontsize=9, color="#7A869A", penwidth=1.3];
  subgraph cluster_0 { label=<<B>Catálogos</B>>; fontsize=16; fontcolor="#4A6FA5"; style="rounded,dashed"; color="#4A6FA5"; margin=16;
    document_types [shape=plain, label=<<TABLE BORDER="1" COLOR="#4A6FA5" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#EEF3FA"><TR><TD COLSPAN="2" BGCOLOR="#4A6FA5" ALIGN="CENTER" CELLPADDING="7"><FONT COLOR="white" POINT-SIZE="13"><B>document_types</B></FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="34" PORT="id_w"><FONT POINT-SIZE="9" COLOR="#B7791F"><B>PK</B></FONT></TD><TD ALIGN="LEFT" PORT="id_e"><B>id</B></TD></TR><TR><TD ALIGN="LEFT" WIDTH="34" PORT="code_w"><FONT POINT-SIZE="9" COLOR="#4A6FA5"><B>UQ</B></FONT></TD><TD ALIGN="LEFT" PORT="code_e">code</TD></TR><TR><TD ALIGN="LEFT" WIDTH="34" PORT="name_w"> </TD><TD ALIGN="LEFT" PORT="name_e">name</TD></TR></TABLE>>];
    cities [shape=plain, label=<<TABLE BORDER="1" COLOR="#4A6FA5" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#EEF3FA"><TR><TD COLSPAN="2" BGCOLOR="#4A6FA5" ALIGN="CENTER" CELLPADDING="7"><FONT COLOR="white" POINT-SIZE="13"><B>cities</B></FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="34" PORT="id_w"><FONT POINT-SIZE="9" COLOR="#B7791F"><B>PK</B></FONT></TD><TD ALIGN="LEFT" PORT="id_e"><B>id</B></TD></TR><TR><TD ALIGN="LEFT" WIDTH="34" PORT="name_w"><FONT POINT-SIZE="9" COLOR="#4A6FA5"><B>UQ</B></FONT></TD><TD ALIGN="LEFT" PORT="name_e">name</TD></TR><TR><TD ALIGN="LEFT" WIDTH="34" PORT="department_w"><FONT POINT-SIZE="9" COLOR="#4A6FA5"><B>UQ</B></FONT></TD><TD ALIGN="LEFT" PORT="department_e">department</TD></TR></TABLE>>];
    specialties [shape=plain, label=<<TABLE BORDER="1" COLOR="#4A6FA5" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#EEF3FA"><TR><TD COLSPAN="2" BGCOLOR="#4A6FA5" ALIGN="CENTER" CELLPADDING="7"><FONT COLOR="white" POINT-SIZE="13"><B>specialties</B></FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="34" PORT="id_w"><FONT POINT-SIZE="9" COLOR="#B7791F"><B>PK</B></FONT></TD><TD ALIGN="LEFT" PORT="id_e"><B>id</B></TD></TR><TR><TD ALIGN="LEFT" WIDTH="34" PORT="name_w"><FONT POINT-SIZE="9" COLOR="#4A6FA5"><B>UQ</B></FONT></TD><TD ALIGN="LEFT" PORT="name_e">name</TD></TR></TABLE>>];
    allergens [shape=plain, label=<<TABLE BORDER="1" COLOR="#4A6FA5" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#EEF3FA"><TR><TD COLSPAN="2" BGCOLOR="#4A6FA5" ALIGN="CENTER" CELLPADDING="7"><FONT COLOR="white" POINT-SIZE="13"><B>allergens</B></FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="34" PORT="id_w"><FONT POINT-SIZE="9" COLOR="#B7791F"><B>PK</B></FONT></TD><TD ALIGN="LEFT" PORT="id_e"><B>id</B></TD></TR><TR><TD ALIGN="LEFT" WIDTH="34" PORT="name_w"><FONT POINT-SIZE="9" COLOR="#4A6FA5"><B>UQ</B></FONT></TD><TD ALIGN="LEFT" PORT="name_e">name</TD></TR></TABLE>>];
    history_types [shape=plain, label=<<TABLE BORDER="1" COLOR="#4A6FA5" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#EEF3FA"><TR><TD COLSPAN="2" BGCOLOR="#4A6FA5" ALIGN="CENTER" CELLPADDING="7"><FONT COLOR="white" POINT-SIZE="13"><B>history_types</B></FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="34" PORT="id_w"><FONT POINT-SIZE="9" COLOR="#B7791F"><B>PK</B></FONT></TD><TD ALIGN="LEFT" PORT="id_e"><B>id</B></TD></TR><TR><TD ALIGN="LEFT" WIDTH="34" PORT="name_w"><FONT POINT-SIZE="9" COLOR="#4A6FA5"><B>UQ</B></FONT></TD><TD ALIGN="LEFT" PORT="name_e">name</TD></TR></TABLE>>];
    diagnoses [shape=plain, label=<<TABLE BORDER="1" COLOR="#4A6FA5" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#EEF3FA"><TR><TD COLSPAN="2" BGCOLOR="#4A6FA5" ALIGN="CENTER" CELLPADDING="7"><FONT COLOR="white" POINT-SIZE="13"><B>diagnoses</B></FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="34" PORT="id_w"><FONT POINT-SIZE="9" COLOR="#B7791F"><B>PK</B></FONT></TD><TD ALIGN="LEFT" PORT="id_e"><B>id</B></TD></TR><TR><TD ALIGN="LEFT" WIDTH="34" PORT="code_w"><FONT POINT-SIZE="9" COLOR="#4A6FA5"><B>UQ</B></FONT></TD><TD ALIGN="LEFT" PORT="code_e">code</TD></TR><TR><TD ALIGN="LEFT" WIDTH="34" PORT="name_w"> </TD><TD ALIGN="LEFT" PORT="name_e">name</TD></TR><TR><TD ALIGN="LEFT" WIDTH="34" PORT="is_glaucoma_w"> </TD><TD ALIGN="LEFT" PORT="is_glaucoma_e">is_glaucoma</TD></TR></TABLE>>];
    glaucoma_types [shape=plain, label=<<TABLE BORDER="1" COLOR="#4A6FA5" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#EEF3FA"><TR><TD COLSPAN="2" BGCOLOR="#4A6FA5" ALIGN="CENTER" CELLPADDING="7"><FONT COLOR="white" POINT-SIZE="13"><B>glaucoma_types</B></FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="34" PORT="id_w"><FONT POINT-SIZE="9" COLOR="#B7791F"><B>PK</B></FONT></TD><TD ALIGN="LEFT" PORT="id_e"><B>id</B></TD></TR><TR><TD ALIGN="LEFT" WIDTH="34" PORT="name_w"><FONT POINT-SIZE="9" COLOR="#4A6FA5"><B>UQ</B></FONT></TD><TD ALIGN="LEFT" PORT="name_e">name</TD></TR></TABLE>>];
    medications [shape=plain, label=<<TABLE BORDER="1" COLOR="#4A6FA5" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#EEF3FA"><TR><TD COLSPAN="2" BGCOLOR="#4A6FA5" ALIGN="CENTER" CELLPADDING="7"><FONT COLOR="white" POINT-SIZE="13"><B>medications</B></FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="34" PORT="id_w"><FONT POINT-SIZE="9" COLOR="#B7791F"><B>PK</B></FONT></TD><TD ALIGN="LEFT" PORT="id_e"><B>id</B></TD></TR><TR><TD ALIGN="LEFT" WIDTH="34" PORT="name_w"><FONT POINT-SIZE="9" COLOR="#4A6FA5"><B>UQ</B></FONT></TD><TD ALIGN="LEFT" PORT="name_e">name</TD></TR><TR><TD ALIGN="LEFT" WIDTH="34" PORT="active_ingredient_w"> </TD><TD ALIGN="LEFT" PORT="active_ingredient_e">active_ingredient</TD></TR><TR><TD ALIGN="LEFT" WIDTH="34" PORT="presentation_w"> </TD><TD ALIGN="LEFT" PORT="presentation_e">presentation</TD></TR><TR><TD ALIGN="LEFT" WIDTH="34" PORT="is_active_w"> </TD><TD ALIGN="LEFT" PORT="is_active_e">is_active</TD></TR></TABLE>>];
    procedure_types [shape=plain, label=<<TABLE BORDER="1" COLOR="#4A6FA5" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#EEF3FA"><TR><TD COLSPAN="2" BGCOLOR="#4A6FA5" ALIGN="CENTER" CELLPADDING="7"><FONT COLOR="white" POINT-SIZE="13"><B>procedure_types</B></FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="34" PORT="id_w"><FONT POINT-SIZE="9" COLOR="#B7791F"><B>PK</B></FONT></TD><TD ALIGN="LEFT" PORT="id_e"><B>id</B></TD></TR><TR><TD ALIGN="LEFT" WIDTH="34" PORT="name_w"><FONT POINT-SIZE="9" COLOR="#4A6FA5"><B>UQ</B></FONT></TD><TD ALIGN="LEFT" PORT="name_e">name</TD></TR><TR><TD ALIGN="LEFT" WIDTH="34" PORT="category_w"> </TD><TD ALIGN="LEFT" PORT="category_e">category</TD></TR></TABLE>>];
  }
  subgraph cluster_1 { label=<<B>Paciente e historia</B>>; fontsize=16; fontcolor="#0F7C7C"; style="rounded,dashed"; color="#0F7C7C"; margin=16;
    patients [shape=plain, label=<<TABLE BORDER="1" COLOR="#0F7C7C" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#E8F6F5"><TR><TD COLSPAN="2" BGCOLOR="#0F7C7C" ALIGN="CENTER" CELLPADDING="7"><FONT COLOR="white" POINT-SIZE="13"><B>patients</B></FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="34" PORT="id_w"><FONT POINT-SIZE="9" COLOR="#B7791F"><B>PK</B></FONT></TD><TD ALIGN="LEFT" PORT="id_e"><B>id</B></TD></TR><TR><TD ALIGN="LEFT" WIDTH="34" PORT="document_type_id_w"><FONT POINT-SIZE="9" COLOR="#0F7C7C"><B>FK</B></FONT></TD><TD ALIGN="LEFT" PORT="document_type_id_e">document_type_id</TD></TR><TR><TD ALIGN="LEFT" WIDTH="34" PORT="document_number_w"><FONT POINT-SIZE="9" COLOR="#0F7C7C"><B>UQ</B></FONT></TD><TD ALIGN="LEFT" PORT="document_number_e">document_number</TD></TR><TR><TD ALIGN="LEFT" WIDTH="34" PORT="first_name_w"> </TD><TD ALIGN="LEFT" PORT="first_name_e">first_name</TD></TR><TR><TD ALIGN="LEFT" WIDTH="34" PORT="last_name_w"> </TD><TD ALIGN="LEFT" PORT="last_name_e">last_name</TD></TR><TR><TD ALIGN="LEFT" WIDTH="34" PORT="birth_date_w"> </TD><TD ALIGN="LEFT" PORT="birth_date_e">birth_date</TD></TR><TR><TD ALIGN="LEFT" WIDTH="34" PORT="sex_w"> </TD><TD ALIGN="LEFT" PORT="sex_e">sex</TD></TR><TR><TD ALIGN="LEFT" WIDTH="34" PORT="email_w"> </TD><TD ALIGN="LEFT" PORT="email_e">email</TD></TR><TR><TD ALIGN="LEFT" WIDTH="34" PORT="phone_w"> </TD><TD ALIGN="LEFT" PORT="phone_e">phone</TD></TR><TR><TD ALIGN="LEFT" WIDTH="34" PORT="address_w"> </TD><TD ALIGN="LEFT" PORT="address_e">address</TD></TR><TR><TD ALIGN="LEFT" WIDTH="34" PORT="city_id_w"><FONT POINT-SIZE="9" COLOR="#0F7C7C"><B>FK</B></FONT></TD><TD ALIGN="LEFT" PORT="city_id_e">city_id</TD></TR><TR><TD ALIGN="LEFT" WIDTH="34" PORT="created_at_w"> </TD><TD ALIGN="LEFT" PORT="created_at_e">created_at</TD></TR><TR><TD ALIGN="LEFT" WIDTH="34" PORT="updated_at_w"> </TD><TD ALIGN="LEFT" PORT="updated_at_e">updated_at</TD></TR></TABLE>>];
