    patient_allergies [shape=plain, label=<<TABLE BORDER="1" COLOR="#0F7C7C" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#E8F6F5"><TR><TD COLSPAN="2" BGCOLOR="#0F7C7C" ALIGN="CENTER" CELLPADDING="7"><FONT COLOR="white" POINT-SIZE="13"><B>patient_allergies</B></FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="34" PORT="patient_id_w"><FONT POINT-SIZE="9" COLOR="#B7791F"><B>PK FK</B></FONT></TD><TD ALIGN="LEFT" PORT="patient_id_e"><B>patient_id</B></TD></TR><TR><TD ALIGN="LEFT" WIDTH="34" PORT="allergen_id_w"><FONT POINT-SIZE="9" COLOR="#B7791F"><B>PK FK</B></FONT></TD><TD ALIGN="LEFT" PORT="allergen_id_e"><B>allergen_id</B></TD></TR><TR><TD ALIGN="LEFT" WIDTH="34" PORT="reaction_w"> </TD><TD ALIGN="LEFT" PORT="reaction_e">reaction</TD></TR></TABLE>>];
