  PACIENTE [shape=box, style="rounded,filled", fillcolor="#E8F6F5", color="#0F7C7C", penwidth=2, fontsize=13, fontcolor="#0F7C7C", margin="0.18,0.1", label=<<B>PACIENTE</B>>];
